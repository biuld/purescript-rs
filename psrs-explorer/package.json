{
  "name": "purescript-rs-psrs-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "snapshots": "rustc tools/generate-snapshots.rs -o /private/tmp/psrs-explorer-snapshots && /private/tmp/psrs-explorer-snapshots",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
