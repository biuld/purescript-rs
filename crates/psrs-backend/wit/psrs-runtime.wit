// The compiler runtime ABI, described in WIT and lowered to the Component
// Model canonical ABI. See docs/decision/DEC-06-runtime-interface-via-wit.md.

package psrs:runtime;

/// Host services the compiled program may call. The PureScript-facing standard
/// libraries wrap these operations; the source language never names them.
interface runtime {
    /// Writes a line to standard output.
    log: func(msg: string);
}
